generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTRUCTOR
  APRENDIZ
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum TipoNotificacion {
  INFO
  ADVERTENCIA
  URGENTE
}

enum EstadoAprendiz {
  EN_FORMACION
  EN_RIESGO
  CONDICIONADO
  RETIRO_VOLUNTARIO
  CERTIFICADO
}

model User {
  id                     String          @id @default(uuid())
  firstName              String          @map("first_name")
  lastName               String          @map("last_name")
  email                  String          @unique
  password               String?         // opcional: usuarios Google no tienen password local
  authProvider           AuthProvider    @default(LOCAL) @map("auth_provider")
  role                   Role            @default(APRENDIZ)
  estadoAcademico        EstadoAprendiz? @default(EN_FORMACION) @map("estado_academico")
  phone                  String?
  isActive               Boolean         @default(true) @map("is_active")
  isEmailVerified        Boolean         @default(false) @map("is_email_verified")
  emailVerificationToken String?         @map("email_verification_token")
  emailVerificationExpires DateTime?      @map("email_verification_expires")
  resetPasswordToken     String?         @map("reset_password_token")
  resetPasswordExpires   DateTime?       @map("reset_password_expires")
  magicLinkToken         String?         @map("magic_link_token")
  magicLinkExpires       DateTime?       @map("magic_link_expires")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  refreshTokens          RefreshToken[]
  fichasComoInstructor   Ficha[]         @relation("InstructorFichas")
  fichasComoAprendiz     FichaAprendiz[] @relation("AprendizFichas")
  calificaciones         Calificacion[]  @relation("AprendizCalificaciones")
  notificaciones         Notificacion[]
  auditLogs              AuditLog[]
  evidenciasComoInstructor Evidencia[]   @relation("InstructorEvidencias")
  entregasComoAprendiz   EntregaEvidencia[] @relation("AprendizEntregas")

  @@map("users")
}

model RefreshToken {
  id              String    @id @default(uuid())
  token           String    @unique
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByToken String?   @map("replaced_by_token")

  @@map("refresh_tokens")
}

enum Jornada {
  MANANA
  TARDE
  NOCHE
  MIXTA
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  TARDANZA
  EXCUSA
}

model Programa {
  id              String   @id @default(uuid())
  nombre          String
  codigo          String   @unique
  duracionMeses   Int      @map("duracion_meses")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fichas          Ficha[]
  modulos         Modulo[]

  @@map("programas")
}

model Modulo {
  id                String   @id @default(uuid())
  nombre            String
  horasFormacion    Int      @map("horas_formacion")
  programaId        String   @map("programa_id")
  programa          Programa @relation(fields: [programaId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")

  calificaciones    Calificacion[]

  @@map("modulos")
}

model Ficha {
  id            String    @id @default(uuid())
  numero        String    @unique
  jornada       Jornada
  fechaInicio   DateTime  @map("fecha_inicio")
  fechaFin      DateTime? @map("fecha_fin")
  isActive      Boolean   @default(true) @map("is_active")

  programaId    String    @map("programa_id")
  programa      Programa  @relation(fields: [programaId], references: [id], onDelete: Restrict)

  instructorId  String?   @map("instructor_id")
  instructor    User?     @relation("InstructorFichas", fields: [instructorId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  aprendices    FichaAprendiz[]
  horarios      Horario[]
  calificaciones Calificacion[]
  evidencias    Evidencia[]

  @@map("fichas")
}

// Tabla intermedia: un aprendiz puede estar en una ficha, una ficha tiene muchos aprendices
model FichaAprendiz {
  id          String   @id @default(uuid())
  fichaId     String   @map("ficha_id")
  ficha       Ficha    @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  aprendizId  String   @map("aprendiz_id")
  aprendiz    User     @relation("AprendizFichas", fields: [aprendizId], references: [id], onDelete: Cascade)
  fechaIngreso DateTime @default(now()) @map("fecha_ingreso")

  asistencias Asistencia[]

  @@unique([fichaId, aprendizId])
  @@map("ficha_aprendices")
}

model Horario {
  id            String   @id @default(uuid())
  fichaId       String   @map("ficha_id")
  ficha         Ficha    @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  diaSemana     Int      @map("dia_semana") // 1=Lunes ... 7=Domingo
  horaInicio    String   @map("hora_inicio") // "07:00"
  horaFin       String   @map("hora_fin")    // "12:00"
  ambiente      String?
  tema          String?
  createdAt     DateTime @default(now()) @map("created_at")

  asistencias   Asistencia[]

  @@map("horarios")
}

model Asistencia {
  id              String            @id @default(uuid())
  fichaAprendizId String            @map("ficha_aprendiz_id")
  fichaAprendiz   FichaAprendiz     @relation(fields: [fichaAprendizId], references: [id], onDelete: Cascade)
  horarioId       String            @map("horario_id")
  horario         Horario           @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  fecha           DateTime          @db.Date
  estado          EstadoAsistencia  @default(PRESENTE)
  observacion     String?
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([fichaAprendizId, horarioId, fecha])
  @@map("asistencias")
}

model Calificacion {
  id          String   @id @default(uuid())
  aprendizId  String   @map("aprendiz_id")
  aprendiz    User     @relation("AprendizCalificaciones", fields: [aprendizId], references: [id], onDelete: Cascade)
  fichaId     String   @map("ficha_id")
  ficha       Ficha    @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  moduloId    String   @map("modulo_id")
  modulo      Modulo   @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  nota        Decimal  @db.Decimal(3, 1) // ej: 4.5, escala 1.0 a 5.0
  periodo     String   // ej: "2026-1"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([aprendizId, moduloId, periodo])
  @@map("calificaciones")
}

model Notificacion {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String
  mensaje   String
  tipo      TipoNotificacion @default(INFO)
  leido     Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("notificaciones")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accion    String
  detalles  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Evidencia {
  id           String             @id @default(uuid())
  titulo       String
  descripcion  String
  fechaLimite  DateTime           @map("fecha_limite")
  fichaId      String             @map("ficha_id")
  ficha        Ficha              @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  instructorId String             @map("instructor_id")
  instructor   User               @relation("InstructorEvidencias", fields: [instructorId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now()) @map("created_at")
  entregas     EntregaEvidencia[]

  @@map("evidencias")
}

model EntregaEvidencia {
  id           String    @id @default(uuid())
  evidenciaId  String    @map("evidencia_id")
  evidencia    Evidencia @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  aprendizId   String    @map("aprendiz_id")
  aprendiz     User      @relation("AprendizEntregas", fields: [aprendizId], references: [id], onDelete: Cascade)
  archivoUrl   String?   @map("archivo_url")
  comentario   String?
  nota         Decimal?  @db.Decimal(3, 1)
  fechaEntrega DateTime  @default(now()) @map("fecha_entrega")

  @@unique([evidenciaId, aprendizId])
  @@map("entrega_evidencias")
}
